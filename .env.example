# Copy to .env.local and fill in. Never commit .env.local — .gitignore
# already excludes every .env* file.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Production origin, no trailing slash. Drives canonical URLs, OG tags and
# the sitemap.
NEXT_PUBLIC_SITE_URL="https://coachmohamednaama.com"

# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Defaults to the confirmed number in src/content/site.ts when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER="13476537295"

# ---------------------------------------------------------------------------
# Google Sheets — application form storage
# ---------------------------------------------------------------------------
# All three are required before submissions are written anywhere. Until they
# are set the form still validates and shows its success state, and the payload
# is logged server-side with a warning. See docs/02-google-sheets-setup.md.
#
# These are server-only. They are NOT prefixed NEXT_PUBLIC_, so they never
# reach the browser bundle.

# From the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Service account address, e.g. naama-forms@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# The service account's private key, on ONE line, with literal \n sequences
# kept exactly as they appear in the downloaded JSON. Keep the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Optional. Sheet tab and column range to append to.
GOOGLE_SHEETS_RANGE="Applications!A:Z"
