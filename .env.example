# Copy to .env.local for local use; on Vercel, add the same names under
# Settings → Environment Variables. .env.local is gitignored: never commit it.
# docs/launch-handoff.md says where each value comes from.

# Required to store applications. The spreadsheet ID: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Required. The service account's address: "client_email" in its JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# Required, secret. "private_key" from the same JSON file, pasted whole inside double quotes with the \n kept.
GOOGLE_PRIVATE_KEY=""

# Optional. Public address with no trailing slash, e.g. https://your-domain.com. Unset on Vercel, the project's production address is used.
# NEXT_PUBLIC_SITE_URL=""

# Optional. WhatsApp number as digits with the country code, no + or spaces. Unset, the number in src/content/site.ts is used.
# NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Development only. Rehearses a submission outcome (success, invalid, failure or rate-limited); ignored by production builds.
# APPLY_DEV_SIMULATE=""
