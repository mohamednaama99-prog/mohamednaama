# Copy to .env.local and fill in. Never commit .env.local — .gitignore
# already excludes every .env* file except this one.
#
# docs/launch-handoff.md walks through where every value comes from.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Production origin, no trailing slash. Drives canonical URLs, OG tags and
# the sitemap. Read at build time: change it, then redeploy.
NEXT_PUBLIC_SITE_URL="https://coachmohamednaama.com"

# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Defaults to the confirmed number in src/content/site.ts when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER="13476537295"

# ---------------------------------------------------------------------------
# Google Sheets — where applications are stored
# ---------------------------------------------------------------------------
# All three are required. Until they are set, the form validates normally but
# every submission ends in the "could not send" message with the WhatsApp
# fallback, and the server log names the missing variable (never a value).
#
# Server-only: none of these is prefixed NEXT_PUBLIC_, and the code that reads
# them imports "server-only", so they can never reach the browser.

# From the spreadsheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""

# "client_email" in the service account's JSON key file,
# e.g. naama-applications@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# "private_key" in the same JSON file. Paste it exactly as it appears there:
# one line, with the \n sequences kept, inside double quotes. A key pasted with
# real line breaks (still inside the quotes) works too.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Rehearses a submission outcome without touching Google Sheets:
# success | invalid | failure | rate-limited. Ignored in production builds.
# APPLY_DEV_SIMULATE="success"
